<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MunoRace_Centrifuge</defName>
    <label>缪诺乳分离机</label>
    <description>自动将多余的缪诺乳分离为乳清和乳源质浓浆。搬运工负责装填，通电后无需操作员。每个游戏小时处理 25 份缪诺乳，产出 25 份乳清和 1 份乳源质浓浆。出口堵塞时暂停生产并保留产物。</description>
    <thingClass>MunoRaceLib.MunoBiotech.Production.Building_MunoMilkSeparator</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Building/MunoRace_Centrifuge</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,2.2)</drawSize>
    </graphicData>
    <size>(1,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <uiOrder>2532</uiOrder>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>25</Mass>
    </statBases>
    <costList><Steel>100</Steel><ComponentIndustrial>5</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>100</fuelCapacity>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>0.75</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <showFuelGizmo>true</showFuelGizmo>
        <canEjectFuel>true</canEjectFuel>
        <fuelLabel>待分离缪诺乳</fuelLabel>
        <fuelGizmoLabel>待分离缪诺乳</fuelGizmoLabel>
        <outOfFuelMessage>需要装填缪诺乳</outOfFuelMessage>
        <fuelFilter><thingDefs><li>MunoRace_MunoMilk</li></thingDefs></fuelFilter>
      </li>
    </comps>
    <researchPrerequisites><li>Electricity</li><li>Muno_MilkApplication</li></researchPrerequisites>
    <placeWorkers><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
  </ThingDef>
</Defs>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- 强化药水 -->
  <ThingDef ParentName="ResourceBase">
    <defName>MunoRace_Potion</defName>
    <label>强化药水</label>
    <description>可以强化缪诺乳源质储量，积累速度的药水，药水效果随着使用次数逐渐递增，多次使用后会出现副作用。</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Item/Resource/MunoRace_Potion</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>6</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.7</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>600</WorkToMake>
    </statBases>
    <costList>
      <Neutroamine>2</Neutroamine>
      <MunoRace_ConcentratedMulacte>5</MunoRace_ConcentratedMulacte>
    </costList>
    <recipeMaker>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <displayPriority>2200</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>服用强化药水</useLabel>
        <useDuration>100</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>MunoRaceLib.MunoComp.HediffComp_UpgradeGalactogen</compClass>
      </li>
    </comps>
  </ThingDef>



</Defs>
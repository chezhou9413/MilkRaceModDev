<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--限制解除器-->
  <ThingDef ParentName="ResourceBase">
    <defName>MunoRace_Disabler</defName>
    <label>限制解除器</label>
    <description>一块小小的芯片，能够插入缪诺通用接口，释放特殊电信号，使生物质材料细胞内部的安全机关失控，并进一步引导材料变异为某种形态的生物。据信是边缘世界的黑客制作的。穿着触手动力甲时使用，可将其转化为狂乱触手甲。</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Item/Resource/MunoRace_Disabler</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>6</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.7</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>解除触手动力甲限制</useLabel>
        <useDuration>100</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>MunoRaceLib.MunoComp.CompUseEffect_TentacleArmorDisabler</compClass>
      </li>
    </comps>
  </ThingDef>



</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       缪诺廉价步枪（Gun_MunoCR）

       贴图：Graphic_Random 从 Weapons/MunoCR 目录里随机取一张。
             注意 Verse.Graphic_Collection.Init 用的是
             ContentFinder<Texture2D>.GetAllInFolder(texPath)，
             会把 texPath 目录下的**所有**贴图都收进 subGraphics，
             所以这四张图必须单独放在一个只含它们的文件夹里，
             不能直接放在 Weapons/ 根目录（否则会随机到别的枪的图）。
             具体走哪一张由 subGraphics[thing.thingIDNumber % 4] 决定，
             即同一把枪的外观固定，不同枪之间随机。

       音效：与 Gun_SR 一致（Muno_Shot_SR + GunTail_Medium）。
       弹药：Bullet_SR（全威力弹）。
       ============================================================ -->

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Gun_MunoCR</defName>
    <label>缪诺廉价步枪</label>
    <description>一种可以大规模制造的步枪，使用全威力步枪弹，火力可观但准度较差，枪身除了一串数字编号外没有任何标识。实际上这些步枪是服务于缪诺聚落的一个附带同化计划，用于供给边缘世界增加不稳定度，为插足其中制造机会</description>
    <graphicData>
      <texPath>Weapons/MunoCR</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>1.4</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>4.2</Mass>
      <AccuracyTouch>0.50</AccuracyTouch>
      <AccuracyShort>0.62</AccuracyShort>
      <AccuracyMedium>0.50</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Muno_Basicfirearms</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>MunoRace_MachineTool</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_SR</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <range>34</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>Muno_Shot_SR</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags Inherit="false">
      <li>MunoGunBasic</li>
    </weaponTags>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>

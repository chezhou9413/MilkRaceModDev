<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ============================================================
	     缪诺近战武器：制式斧 / 制式刀
	     参考原版 MeleeWeapon_Axe / MeleeWeapon_LongSword 的写法。
	     父类 BaseMeleeWeapon_Sharp_Quality 已提供：
	       CompEquippable / CompQuality / CompProperties_Art / CompProperties_Forbiddable /
	       CompProperties_Styleable / thingClass=ThingWithComps / category=Item /
	       thingCategories=WeaponsMelee / weaponClasses=(Melee, MeleePiercer) /
	       tradeTags=(WeaponMelee) / recipeMaker 骨架(workSkill=Crafting, effectWorking=Smith) 等
	     贴图：Textures/Weapons/Melee_MunoAxe.png、Textures/Weapons/Melee_MunoSword.png
	     ============================================================ -->

	<!-- ============ 缪诺制式斧 ============ -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>MunoRace_MeleeAxe</defName>
		<label>缪诺制式斧</label>
		<description>缪诺军队的制式单手战斧。工业批量生产的制式武器，每一把长得都基本一个样，兼具劈砍与破甲能力，既是战场上可靠的近战武器，也是聚落中常见的实用工具。</description>
		<graphicData>
			<texPath>Weapons/Melee_MunoAxe</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<equippedAngleOffset>-65</equippedAngleOffset>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<statBases>
			<WorkToMake>7000</WorkToMake>
			<Mass>1.5</Mass>
		</statBases>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>17</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<weaponTags>
			<li>MunoMelee</li>
			<li>Axe</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>Muno_BasicMelee</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>MunoRace_WorkBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<displayPriority>430</displayPriority>
		</recipeMaker>
	</ThingDef>

	<!-- ============ 缪诺制式刀 ============ -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">

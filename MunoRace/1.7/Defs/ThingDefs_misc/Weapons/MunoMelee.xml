			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<displayPriority>420</displayPriority>
		</recipeMaker>
	</ThingDef>

	<!-- ============ 缪诺警棍 ============ -->
	<ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
		<defName>MunoRace_MeleeBaton</defName>
		<label>缪诺警棍</label>
		<description>缪诺聚落治安人员使用的制式警棍。工业批量生产的制式武器，每一把长得都基本一个样,钝头设计能在制服目标的同时尽量避免致命伤，附带的电极能够有效的电击瘫痪目标，是巡逻与镇暴的常用装备，在缪诺牧场中也有使用。</description>
		<graphicData>
			<texPath>Weapons/Melee_MunoBatons</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<equippedAngleOffset>-65</equippedAngleOffset>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
		</stuffCategories>
		<statBases>
			<WorkToMake>6000</WorkToMake>
			<Mass>1.25</Mass>
		</statBases>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>16</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<weaponClasses Inherit="False">
			<li>MeleeBlunt</li>
			<li>Melee</li>
		</weaponClasses>
		<weaponTags>
			<li>MunoMelee</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>Muno_BasicMelee</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>MunoRace_WorkBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>3</Crafting>
			</skillRequirements>
			<displayPriority>410</displayPriority>
		</recipeMaker>
	</ThingDef>

</Defs>

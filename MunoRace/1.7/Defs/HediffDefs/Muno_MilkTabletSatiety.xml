<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 缪诺乳奶片的饱腹载体：3 天内饥饿速度归零，饮食条不会下降。
       依据 Verse.HediffSet.GetHungerRateFactor：
         num *= curStage.hungerRateFactor;
       而 Need_Food.FoodFallPerTickAssumingCategory 又把这个 num 乘进饥饿速度，
       所以把 hungerRateFactor 设为 0 即可让饮食条完全不再下降。 -->
  <HediffDef>
    <defName>Muno_MilkTabletSatiety</defName>
    <label>奶片饱腹</label>
    <description>缪诺乳奶片在体内缓慢释放营养，让人长时间不必进食。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.92, 0.85, 0.55)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <hungerRateFactor>0</hungerRateFactor>
      </li>
    </stages>
    <comps>
      <!-- 3 天 = 3 × 60000 tick -->
      <li Class="Verse.HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================================================
	     缪诺 PawnKindDef
	     结构参照原版 PawnKinds_Mercenary.xml / Villager：
	     - 抽象基类存放所有缪诺共用的默认值
	     - 具体类型覆盖战斗、装备、技能、经济相关字段
	     所有缪诺出生使用名字库 MunoRaceNamePack（见 MunoRaceNamePack.xml）
	     ============================================================ -->

	<!-- 抽象基类：通用默认值 -->
	<PawnKindDef Name="MunoGirlBasePawnKind" Abstract="True">
		<race>MunoRace</race>
		<nameMaker>MunoRaceNamePack</nameMaker>
		<defaultFactionType>MunoColony_Faction</defaultFactionType>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>MunoGirl</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<combatPower>30</combatPower>
		<isFighter>true</isFighter>
		<trader>false</trader>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<invNutrition>2.55</invNutrition>
		<backstoryCryptosleepCommonality>0.08</backstoryCryptosleepCommonality>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<forceNormalGearQuality>true</forceNormalGearQuality>
		<initialWillRange>2~40</initialWillRange>
		<initialResistanceRange>2~40</initialResistanceRange>
		<maxGenerationAge>30</maxGenerationAge>
		<useFactionXenotypes>false</useFactionXenotypes>
	</PawnKindDef>

	<!-- ============ 玩家殖民者 ============ -->
	<PawnKindDef Name="MunoGirl_Colonist" ParentName="MunoGirlBasePawnKind">
		<defName>MunoRace_Colonist</defName>
		<label>缪诺</label>
		<labelPlural>缪诺们</labelPlural>
		<description>被边缘世界殖民者招募的缪诺。她们大多来自缪诺聚落，也可能是在突袭中叛逃或被救出的改造个体。她们拥有缪诺种族的一切特性，是可靠的同伴与生产力来源。</description>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<itemQuality>Normal</itemQuality>
		<gearHealthRange>1~1</gearHealthRange>
		<apparelMoney>1600~5000</apparelMoney>
		<apparelAllowHeadgearChance>0.8</apparelAllowHeadgearChance>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>MunoGirl</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<!--<apparelTags>
			<li>DR_Apparel</li>
		</apparelTags>-->
		<!-- <abilities>
        <li>DR_FireBurst</li>
		</abilities> -->
	</PawnKindDef>

	<!-- ============ 和亲公主 ============ -->
	<PawnKindDef ParentName="MunoGirl_Colonist">
		<defName>MunoRace_MarriagePrincess</defName>
		<label>缪诺和亲公主</label>
		<labelPlural>缪诺和亲公主们</labelPlural>
		<description>缪诺聚落派往外族进行和亲的外交人员。她们受过礼仪训练，举止得体，擅长交际，通常携带精致的嫁妆与随行物资。</description>
		<defaultFactionType>MunoColony_Faction</defaultFactionType>
		<isFighter>false</isFighter>
		<combatPower>35</combatPower>
		<itemQuality>Good</itemQuality>
		<gearHealthRange>1~1</gearHealthRange>
		<minGenerationAge>18</minGenerationAge>
		<maxGenerationAge>28</maxGenerationAge>
		<apparelMoney>1600~3600</apparelMoney>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>IndustrialAdvanced</li>
			<li>MunoApparelAdvanced</li>
			<li>BeltDefensePop</li>
		</apparelTags>
		<skills>
			<li>
				<skill>Social</skill>
				<range>4~9</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>2~6</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- ============ 务农缪诺（聚落平民） ============ -->
	<PawnKindDef ParentName="MunoGirlBasePawnKind" Name="MunoRace_VillagerBase">
		<defName>MunoRace_Villager</defName>
		<label>务农缪诺</label>
		<labelPlural>务农缪诺们</labelPlural>
		<description>缪诺聚落中最常见的平民，负责聚落的农牧生产。她们不擅长战斗，但吃苦耐劳，是聚落繁荣的根基。</description>
		<combatPower>45</combatPower>
		<itemQuality>Poor</itemQuality>
		<isFighter>false</isFighter>
		<gearHealthRange>0.2~2.0</gearHealthRange>
		<weaponTags>
			<li>MunoGunBasic</li>
		</weaponTags>
		<weaponMoney>480~1250</weaponMoney>
		<apparelMoney>200~1200</apparelMoney>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>IndustrialAdvanced</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.4</apparelAllowHeadgearChance>
		<techHediffsChance>0.06</techHediffsChance>
		<techHediffsMoney>50~600</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<initialWillRange>0~1</initialWillRange>
		<initialResistanceRange>10~17</initialResistanceRange>
		<skills>
			<li>
				<skill>Plants</skill>
				<range>3~9</range>
			</li>
			<li>
				<skill>Animals</skill>
				<range>3~8</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- ============ 聚落守卫 ============ -->
	<PawnKindDef ParentName="MunoGirlBasePawnKind" Name="MunoRace_GuardBase">
		<defName>MunoRace_Guard</defName>
		<label>缪诺聚落守卫</label>
		<labelPlural>缪诺聚落守卫们</labelPlural>
		<description>缪诺聚落的军事人员，负责保卫聚落、执行突袭和护送任务。她们受过系统训练，装备精良，是缪诺武力的中坚。</description>
		<combatPower>60</combatPower>
		<isFighter>true</isFighter>
		<minGenerationAge>18</minGenerationAge>
		<gearHealthRange>0.6~2</gearHealthRange>
		<apparelTags>
			<li>MunoApparelAdvanced</li>
			<li>MunoArmor</li>
		</apparelTags>
		<apparelMoney>400~1600</apparelMoney>
		<apparelAllowHeadgearChance>0.4</apparelAllowHeadgearChance>
		<weaponTags>
			<li>MunoGunMiddle</li>
			<li>MunoGunAdvanced</li>
		</weaponTags>
		<weaponMoney>505~1400</weaponMoney>
		<biocodeWeaponChance>0.1</biocodeWeaponChance>
		<techHediffsChance>0.04</techHediffsChance>
		<techHediffsMoney>200~700</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<initialWillRange>1~3</initialWillRange>
		<initialResistanceRange>15~24</initialResistanceRange>
		<disallowedTraits>
			<li>Brawler</li>
		</disallowedTraits>
		<combatEnhancingDrugsChance>0.05</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~1</combatEnhancingDrugsCount>
		<inventoryOptions>
			<skipChance>0.9</skipChance>
			<subOptionsChooseOne>
				<li>
					<thingDef>MedicineIndustrial</thingDef>
					<countRange>1</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>5~12</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>2~7</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- ============ 聚落贸易者 ============ -->
	<PawnKindDef ParentName="MunoGirlBasePawnKind" Name="MunoRace_TraderBase">
		<defName>MunoRace_Trader</defName>
		<label>缪诺聚落贸易者</label>
		<labelPlural>缪诺聚落贸易者们</labelPlural>
		<description>代表缪诺聚落与外族进行贸易的商人。她们精于议价，熟悉各种货物的行情，穿梭于各个聚落之间为缪诺获取资源和情报。</description>
		<trader>true</trader>
		<combatPower>45</combatPower>
		<isFighter>false</isFighter>
		<gearHealthRange>1~1</gearHealthRange>
		<itemQuality>Normal</itemQuality>
		<weaponTags>
			<li>MunoGunMiddle</li>
		</weaponTags>
		<weaponMoney>505~1400</weaponMoney>
		<apparelMoney>400~1600</apparelMoney>
		<apparelTags>
			<li>IndustrialMilitaryBasic</li>
			<li>IndustrialMilitaryAdvanced</li>
			<li>BeltDefensePop</li>
		</apparelTags>
		<apparelRequired>
			<li>Apparel_BowlerHat</li>
		</apparelRequired>
		<techHediffsChance>0.15</techHediffsChance>
		<techHediffsMoney>600~1500</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>Advanced</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<initialWillRange>2~4</initialWillRange>
		<initialResistanceRange>12~20</initialResistanceRange>
		<skills>
			<li>
				<skill>Social</skill>
				<range>5~12</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>2~6</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- ============ 聚落管理者（领袖） ============ -->
	<PawnKindDef ParentName="MunoGirlBasePawnKind" Name="MunoRace_CouncilmanBase">
		<defName>MunoRace_Manager</defName>
		<label>缪诺聚落管理者</label>
		<labelPlural>缪诺聚落管理者们</labelPlural>
		<description>缪诺聚落的行政与军事指挥人员，负责制定聚落的发展方向、调度突袭行动与处理外交事务。她们通常由经验丰富的缪诺担任。</description>
		<combatPower>40</combatPower>
		<factionLeader>true</factionLeader>
		<minGenerationAge>20</minGenerationAge>
		<isFighter>false</isFighter>
		<gearHealthRange>1~1</gearHealthRange>
		<itemQuality>Good</itemQuality>
		<weaponMoney>505~1600</weaponMoney>
		<weaponTags>
			<li>MunoGunMiddle</li>
		</weaponTags>
		<apparelMoney>700~1200</apparelMoney>
		<apparelTags>
			<li>IndustrialMilitaryBasic</li>
			<li>BeltDefensePop</li>
		</apparelTags>
		<apparelRequired>
			<li>Apparel_BowlerHat</li>
		</apparelRequired>
		<techHediffsChance>0.15</techHediffsChance>
		<techHediffsMoney>600~1500</techHediffsMoney>
		<techHediffsTags>
			<li>Simple</li>
			<li>Advanced</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<initialWillRange>3~5</initialWillRange>
		<initialResistanceRange>7~11</initialResistanceRange>
		<skills>
			<li>
				<skill>Social</skill>
				<range>5~10</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>3~8</range>
			</li>
		</skills>
	</PawnKindDef>
</Defs>

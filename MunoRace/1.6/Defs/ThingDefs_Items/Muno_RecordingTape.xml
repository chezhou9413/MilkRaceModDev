<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Muno_RecordingTape</defName>
    <label>生存录像带</label>
    <description>记录殖民者生存日常的数据载体。可通过摄像机、剧情联络终端或通讯台向非敌对的缪诺聚落上交，每份录像换取一份随机物资。提交时扫描当前地图上未禁用、已显露的录像带。</description>
    <graphicData>
      <texPath>Things/Item/Special/SubpersonaCoreTechprof</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.5</drawSize>
      <color>(0.95, 0.65, 0.85)</color>
    </graphicData>
    <stackLimit>50</stackLimit>
    <tradeability>None</tradeability>
    <statBases><MaxHitPoints>100</MaxHitPoints><Mass>0.05</Mass><MarketValue>0</MarketValue><Flammability>0.6</Flammability></statBases>
    <thingCategories><li>Items</li></thingCategories>
  </ThingDef>
</Defs>
